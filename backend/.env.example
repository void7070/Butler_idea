# 백엔드 환경변수 예시. 복사해서 .env 로 사용하세요.
# cp .env.example .env  (PowerShell: Copy-Item .env.example .env)

# 서버 포트
PORT=3000

# GPT API 키 (B06 AI 연동에서 사용). 코드/커밋에 직접 넣지 말 것.
OPENAI_API_KEY=
# 사용할 모델
OPENAI_MODEL=gpt-4o-mini

# 시연 기준일 (YYYY-MM-DD). 값이 있으면 서버의 "지금" = 이 날짜 + 실제 현재 시각.
# 리허설과 발표 당일에 D-day·입주 제보 기간·링크 만료가 같은 화면으로 나온다.
# db:init / demo:reset 의 시드(345호 계약 시작 = 기준일 − 2일)도 이 날짜를 쓴다.
# 비워 두면 실제 날짜. 바꾼 뒤에는 서버 재시작 + npm run demo:reset.
DEMO_TODAY=
